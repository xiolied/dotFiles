general {
        colors = true
        interval = 5
        markup = pango
}

order += "wireless _first_"
order += "memory"
order += "battery all"
order += "tztime local"

wireless _first_ {
        format_up = "<span foreground='#7e98e8'>W:</span> %essid"
        format_down = "<span foreground='#7e98e8'>W:</span> Disconnected"
        color_good = "#cdcdcd"
        color_bad= "#d8647e" 
}

battery all {
        format = "<span foreground='#7e98e8'>B:</span> %percentage, %status "
        color_good = "#fa563"
        color_degraded = "#e0a363"
        color_bad= "#d8647e" 
}


memory {
        format = "<span foreground='#7e98e8'>M:</span> %used of %total"
        threshold_degraded = "10%"
        threshold_critical = "5%"
        color_good = "#fa563"
        color_degraded = "#e0a363"
        color_bad= "#d8647e" 
}

tztime local {
        format = "<span foreground='#7e98e8'>C:</span> %a, %d - %I:%M %p "
}
